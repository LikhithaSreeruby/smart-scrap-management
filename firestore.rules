rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId}
    // Fields:
    //   - uid: string (required)
    //   - role: string (required, enum: ["user", "collector", "admin"])
    //   - phone: string (required)
    //   - rating: number (optional)
    //   - total_earned: number (optional)
    //   - displayName: string (optional)
    //   - photoURL: string (optional)
    //   - verified: boolean (optional)
    //
    // Collection: requests
    // Document ID: {requestId}
    // Fields:
    //   - id: string (optional)
    //   - user_id: string (required)
    //   - items: array (required)
    //   - total_estimated_price: number (optional)
    //   - status: string (required, enum: ["pending", "accepted", "picked", "paid", "cancelled"])
    //   - collector_id: string (optional)
    //   - created_at: number (optional)
    //   - address: string (required)
    //   - otp: string (optional)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         (request.auth.token.email == "imandilikhithasree@gmail.com" && request.auth.token.email_verified == true));
    }

    function isCollector() {
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'collector';
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidUser(data) {
      return data.uid is string &&
             data.role in ['user', 'collector', 'admin'] &&
             data.phone is string && data.phone.size() >= 10 && data.phone.size() <= 15;
    }

    function isValidRequest(data) {
      return data.user_id is string &&
             data.items is list &&
             data.status in ["pending", "accepted", "picked", "paid", "cancelled"] &&
             data.address is string && data.address.size() > 0;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      // Users can read their own profile. Admins can read all.
      allow read: if isOwner(userId) || isAdmin();
      
      // Users can create their own profile.
      allow create: if isOwner(userId) && isValidUser(request.resource.data) && 
                    (request.resource.data.role == 'user' || isAdmin());
      
      // Users can update their own profile (but not their role unless admin).
      allow update: if isOwner(userId) && isValidUser(request.resource.data) && 
                    (request.resource.data.role == resource.data.role || isAdmin());
    }

    match /requests/{requestId} {
      // Users can read their own requests. Collectors can read all pending or their own.
      allow read: if isAuthenticated() && (
        resource.data.user_id == request.auth.uid || 
        isCollector() || 
        isAdmin()
      );

      // Users can create requests for themselves.
      allow create: if isAuthenticated() && 
                    request.resource.data.user_id == request.auth.uid && 
                    isValidRequest(request.resource.data) &&
                    request.resource.data.status == 'pending';

      // Users can cancel their own pending requests.
      // Collectors can accept pending requests or update their own.
      allow update: if isAuthenticated() && (
        (resource.data.user_id == request.auth.uid && request.resource.data.status == 'cancelled' && resource.data.status == 'pending') ||
        (isCollector() && resource.data.status == 'pending' && request.resource.data.status == 'accepted' && request.resource.data.collector_id == request.auth.uid) ||
        (resource.data.collector_id == request.auth.uid && isValidRequest(request.resource.data)) ||
        isAdmin()
      );
    }
  }
}
